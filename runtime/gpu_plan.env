# 复制到 /data3/hy/runtime/gpu_plan.env
# 数字是 nvidia-smi 显示的物理 GPU 编号。
# 现在每个进程要独立选卡：
# 文本编码器使用 GPU_TEXT
# ARDY 使用 GPU_ARDY
# SONIC 和 MuJoCo 使用 GPU_SIM
export GPU_TEXT=5
export GPU_ARDY=6
export GPU_SIM=7

export TEXT_ENCODER_PORT=9550
export CAMERA_ZMQ_PORT=5555
export POSE_ZMQ_PORT=5556
export SONIC_WEB_PORT=7870
